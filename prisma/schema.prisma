generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductFactStatus {
  DRAFT
  CONFIRMED
  NEEDS_REVIEW
}

enum StrategyStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum ContentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PlanItemStatus {
  DRAFT
  READY
  REVIEW_NEEDED
  DONE
}

enum ContentPackageStatus {
  DRAFT
  GENERATED
  REVIEW_NEEDED
  APPROVED
  ARCHIVED
}

enum PackageFileStatus {
  PLANNED
  GENERATED
  APPROVED
}

enum ReviewTaskStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELED
}

enum ReviewSubjectType {
  PRODUCT_FACT
  PROJECT_STRATEGY
  CONTENT_PACKAGE
  ASSET
}

enum ReminderSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReminderStatus {
  OPEN
  DONE
  DISMISSED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AgentOperationStatus {
  APPLIED
  PENDING_CONFIRMATION
  REJECTED
  FAILED
}

enum AssetKind {
  PRODUCT_IMAGE
  LOGO
  DOCUMENT
  REFERENCE_IMAGE
  GENERATED_IMAGE
  EXPORT_FILE
}

enum AssetSource {
  USER_UPLOAD
  GENERATED
  IMPORTED
}

enum AssetStatus {
  UPLOADED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ImageGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ImageGenerationMode {
  TEMPLATE_COMPOSITION
  BACKGROUND_GENERATION
  IMAGE_EDIT
  IMAGE_EXPAND
}

enum IntegrationProvider {
  FEISHU
}

enum IntegrationStatus {
  CONNECTED
  DISABLED
  NEEDS_RECONNECT
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     WorkspaceMember[]
  changeLogs      ChangeLog[]
  assignedReviews ReviewTask[]      @relation("ReviewTaskReviewer")
}

model Workspace {
  id                     String                          @id @default(cuid())
  name                   String
  slug                   String                          @unique
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  deletedAt              DateTime?
  members                WorkspaceMember[]
  projects               Project[]
  products               Product[]
  productFacts           ProductFact[]
  projectStrategies      ProjectStrategy[]
  contentPlanItems       ContentPlanItem[]
  contentPackages        ContentPackage[]
  reviewTasks            ReviewTask[]
  reminders              Reminder[]
  conversations          AgentConversation[]
  messages               AgentMessage[]
  operations             AgentOperation[]
  changeLogs             ChangeLog[]
  assets                 Asset[]
  imageProviderConfigs   ImageGenerationProviderConfig[]
  imageGenerationJobs    ImageGenerationJob[]
  integrationConnections IntegrationConnection[]
  integrationMigrations  IntegrationMigrationRecord[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id                  String               @id @default(cuid())
  workspaceId         String
  name                String
  description         String?
  status              ProjectStatus        @default(DRAFT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectProducts     ProjectProduct[]
  strategies          ProjectStrategy[]
  contentPlanItems    ContentPlanItem[]
  contentPackages     ContentPackage[]
  reviewTasks         ReviewTask[]
  reminders           Reminder[]
  conversations       AgentConversation[]
  operations          AgentOperation[]
  changeLogs          ChangeLog[]
  assets              Asset[]
  imageGenerationJobs ImageGenerationJob[]

  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
}

model Product {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  status          ProductStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectProducts ProjectProduct[]
  facts           ProductFact[]
  assets          Asset[]

  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
}

model ProjectProduct {
  projectId String
  productId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([projectId, productId])
  @@index([productId])
}

model ProductFact {
  id          String            @id @default(cuid())
  workspaceId String
  productId   String
  label       String
  value       String
  source      String?
  confidence  Int               @default(80)
  status      ProductFactStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId])
  @@index([workspaceId, status])
}

model ProjectStrategy {
  id                String            @id @default(cuid())
  workspaceId       String
  projectId         String
  version           Int               @default(1)
  status            StrategyStatus    @default(DRAFT)
  targetMarkets     String[]          @default([])
  audiences         String[]          @default([])
  channels          String[]          @default([])
  contentDirections String[]          @default([])
  packageFrequency  ContentFrequency  @default(MONTHLY)
  positioning       String?
  rationale         String?
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentPlanItems  ContentPlanItem[]
  contentPackages   ContentPackage[]

  @@index([workspaceId, projectId, status])
}

model ContentPlanItem {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  strategyId  String?
  week        Int
  channel     String
  theme       String
  title       String
  deliverable String
  dueDate     DateTime?
  status      PlanItemStatus   @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategy    ProjectStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, status])
  @@index([strategyId])
}

model ContentPackage {
  id          String               @id @default(cuid())
  workspaceId String
  projectId   String
  strategyId  String?
  name        String
  period      String
  frequency   ContentFrequency     @default(MONTHLY)
  status      ContentPackageStatus @default(DRAFT)
  summary     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategy    ProjectStrategy?     @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  files       ContentPackageFile[]

  @@index([workspaceId, projectId, status])
  @@index([strategyId])
}

model ContentPackageFile {
  id               String            @id @default(cuid())
  contentPackageId String
  assetId          String?
  name             String
  fileType         String
  status           PackageFileStatus @default(PLANNED)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contentPackage   ContentPackage    @relation(fields: [contentPackageId], references: [id], onDelete: Cascade)
  asset            Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([contentPackageId, status])
  @@index([assetId])
}

model ReviewTask {
  id             String            @id @default(cuid())
  workspaceId    String
  projectId      String?
  subjectType    ReviewSubjectType
  subjectId      String
  title          String
  description    String?
  status         ReviewTaskStatus  @default(PENDING)
  reviewerUserId String?
  decisionNote   String?
  dueAt          DateTime?
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer       User?             @relation("ReviewTaskReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([reviewerUserId])
}

model Reminder {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  description String?
  severity    ReminderSeverity @default(INFO)
  status      ReminderStatus   @default(OPEN)
  dueAt       DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
}

model AgentConversation {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    AgentMessage[]
  operations  AgentOperation[]

  @@index([workspaceId, projectId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  workspaceId    String
  conversationId String
  role           AgentMessageRole
  content        String
  createdAt      DateTime          @default(now())
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversationId, createdAt])
}

model AgentOperation {
  id             String               @id @default(cuid())
  workspaceId    String
  conversationId String?
  projectId      String?
  rawText        String
  summary        String
  operations     Json
  conflictCheck  String?
  status         AgentOperationStatus @default(PENDING_CONFIRMATION)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   AgentConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
}

model ChangeLog {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  entityType  String
  entityId    String
  action      String
  summary     String
  before      Json?
  after       Json?
  actorUserId String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model Asset {
  id                    String               @id @default(cuid())
  workspaceId           String
  projectId             String?
  productId             String?
  name                  String
  kind                  AssetKind
  source                AssetSource          @default(USER_UPLOAD)
  status                AssetStatus          @default(UPLOADED)
  mimeType              String?
  sizeBytes             Int?
  storagePath           String?
  originalFilename      String?
  checksum              String?
  metadata              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project               Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  product               Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  packageFiles          ContentPackageFile[]
  imageGenerationResult ImageGenerationJob[] @relation("GeneratedAsset")

  @@index([workspaceId, kind, status])
  @@index([workspaceId, productId])
  @@index([workspaceId, projectId])
}

model ImageGenerationProviderConfig {
  id           String               @id @default(cuid())
  workspaceId  String
  provider     String
  displayName  String
  defaultModel String?
  enabled      Boolean              @default(false)
  capabilities String[]             @default([])
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs         ImageGenerationJob[]

  @@index([workspaceId, provider])
}

model ImageGenerationJob {
  id               String                         @id @default(cuid())
  workspaceId      String
  projectId        String?
  providerConfigId String?
  resultAssetId    String?
  provider         String
  model            String?
  promptVersion    String
  sourceAssetIds   String[]                       @default([])
  generationMode   ImageGenerationMode
  aspectRatio      String
  status           ImageGenerationStatus          @default(QUEUED)
  error            String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  workspace        Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?                       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  providerConfig   ImageGenerationProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  resultAsset      Asset?                         @relation("GeneratedAsset", fields: [resultAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, projectId])
  @@index([providerConfigId])
  @@index([resultAssetId])
}

model IntegrationConnection {
  id                           String                       @id @default(cuid())
  workspaceId                  String
  provider                     IntegrationProvider
  status                       IntegrationStatus            @default(NEEDS_RECONNECT)
  displayName                  String
  tenantDisplayName            String?
  notificationTargetName       String?
  notificationTargetExternalId String?
  repositoryTargetName         String?
  repositoryTargetExternalId   String?
  notes                        String?
  connectedAt                  DateTime?
  disabledAt                   DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  workspace                    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  migrationRecords             IntegrationMigrationRecord[]

  @@index([workspaceId, provider, status])
}

model IntegrationMigrationRecord {
  id             String                 @id @default(cuid())
  workspaceId    String
  connectionId   String?
  provider       IntegrationProvider
  fromTargetName String?
  toTargetName   String?
  summary        String
  createdAt      DateTime               @default(now())
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, provider, createdAt])
  @@index([connectionId])
}
