# App
APP_NAME="AI 内容增长 Agent"
APP_ENV="development"
APP_URL="http://127.0.0.1:3002"

# Auth
AUTH_SECRET="replace-with-local-dev-secret"
DEMO_USER_EMAIL="demo@example.com"

# Database
POSTGRES_USER="replace-with-local-user"
POSTGRES_PASSWORD="replace-with-local-password"
POSTGRES_DB="ai_content_growth_agent"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://replace-with-local-user:replace-with-local-password@localhost:5432/ai_content_growth_agent?schema=public"

# Object storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI provider
AI_PROVIDER="local-rule"
AI_API_KEY=""
AI_TEXT_MODEL=""
AI_IMAGE_MODEL=""

# Image generation provider placeholders. Do not expose these values in the browser.
IMAGE_GENERATION_PROVIDER=""
IMAGE_GENERATION_API_KEY=""
IMAGE_GENERATION_MODEL=""

# Job scheduling
JOB_QUEUE_PROVIDER="postgres"

# Feishu integration, optional and workspace-scoped
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_ENCRYPT_KEY=""
FEISHU_VERIFICATION_TOKEN=""

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""
