# App
APP_NAME="AI 内容增长 Agent"
APP_ENV="development"
APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="replace-with-local-dev-secret"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_content_growth_agent"

# Object storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI provider
AI_PROVIDER="openai"
AI_API_KEY=""
AI_TEXT_MODEL=""
AI_IMAGE_MODEL=""

# Job scheduling
JOB_QUEUE_PROVIDER="postgres"

# Feishu integration, optional and workspace-scoped
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_ENCRYPT_KEY=""
FEISHU_VERIFICATION_TOKEN=""

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""

